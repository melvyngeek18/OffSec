{
  "expo": {
    "name": "OffSec",
    "slug": "offsec-app",
    "scheme": "offsec",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#262135"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.offsec.app",
      "infoPlist": {
        "NSCameraUsageDescription": "L'application utilise la caméra pour prendre des photos de l'intervention.",
        "NSPhotoLibraryUsageDescription": "L'application accède à vos photos pour les ajouter aux rapports.",
        "NSLocationWhenInUseUsageDescription": "L'application utilise votre position pour localiser l'intervention."
      }
    },
    "android": {
      "package": "com.offsec.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#262135"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "L'application utilise votre position pour localiser l'intervention.",
          "locationWhenInUsePermission": "L'application utilise votre position pour localiser l'intervention."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application accède à vos photos pour les ajouter aux rapports d'intervention.",
          "cameraPermission": "L'application utilise la caméra pour prendre des photos de l'intervention."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "L'application utilise la caméra pour prendre des photos de l'intervention."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24,
            "buildToolsVersion": "34.0.0",
            "kotlinVersion": "1.9.22",
            "newArchEnabled": false
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "offsec-app"
      }
    }
  }
}
