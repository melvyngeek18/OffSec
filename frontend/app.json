{
  "expo": {
    "name": "OffSec",
    "slug": "offsec-app",
    "scheme": "offsec",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#262135"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.offsec.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Prendre des photos de l'intervention",
        "NSPhotoLibraryUsageDescription": "Ajouter des photos aux rapports",
        "NSLocationWhenInUseUsageDescription": "Localiser l'intervention"
      }
    },
    "android": {
      "package": "com.offsec.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#262135"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Localiser l'intervention"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ajouter des photos aux rapports",
          "cameraPermission": "Prendre des photos de l'intervention"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Prendre des photos de l'intervention"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
